From: lyrids <ly7110@gmail.com>
Subject: [PATCH] netfilter: guard MTU snapshots and hardware admission

Extend the generic MTU notifier fix with the experimental routed-device
snapshot, late-admission, lookup and hardware ADD/DESTROY ordering guards
from 18165fc0e8 and 3196df75e4. Keep the existing ingress, logical-output,
physical-output and upper/lower dependency checks from pending patch 709.
NSS and PPE admission use the same routed-device snapshot contract.

Signed-off-by: lyrids <ly7110@gmail.com>

--- a/include/net/netfilter/nf_flow_table.h
+++ b/include/net/netfilter/nf_flow_table.h
@@ -141,6 +141,8 @@
 					port_vlans:2,
 					in_vlan_ingress:2;
 	u16				mtu;
+	u32				mtu_ifindex;
+	u32				mtu_device;
 	union {
 		struct {
 			struct dst_entry *dst_cache;
@@ -191,6 +193,29 @@
 	u32					priority;
 	struct rcu_head				rcu_head;
 };
+
+/* The route MTU may be lower than the device MTU because of PMTU or
+ * encapsulation. Compare the device snapshot, not those two different limits.
+ * Callers hold RCU; this also covers a route resolved before a device change
+ * but published after the notifier's flowtable walk.
+ */
+static inline bool flow_offload_mtu_valid(const struct flow_offload *flow,
+					 struct net *net)
+{
+	int dir;
+
+	if (flow->type != NF_FLOW_OFFLOAD_ROUTE)
+		return true;
+	for (dir = 0; dir < FLOW_OFFLOAD_DIR_MAX; dir++) {
+		const struct flow_offload_tuple *tuple = &flow->tuplehash[dir].tuple;
+		struct net_device *dev;
+
+		dev = dev_get_by_index_rcu(net, tuple->mtu_ifindex);
+		if (!dev || READ_ONCE(dev->mtu) != tuple->mtu_device)
+			return false;
+	}
+	return true;
+}
 
 #define NF_FLOW_TIMEOUT (30 * HZ)
 #define nf_flowtable_time_stamp	(u32)jiffies
--- a/net/netfilter/nf_flow_table_core.c
+++ b/net/netfilter/nf_flow_table_core.c
@@ -100,6 +100,9 @@
 	struct flow_offload_tuple *flow_tuple = &flow->tuplehash[dir].tuple;
 	struct dst_entry *dst = nft_route_dst_fetch(route, dir);
 	int i, j = 0;
+
+	flow_tuple->mtu_ifindex = dst->dev->ifindex;
+	flow_tuple->mtu_device = READ_ONCE(dst->dev->mtu);
 
 	switch (flow_tuple->l3proto) {
 	case NFPROTO_IPV4:
@@ -417,6 +420,11 @@
 	flow = container_of(tuplehash, struct flow_offload, tuplehash[dir]);
 	if (test_bit(NF_FLOW_TEARDOWN, &flow->flags))
 		return NULL;
+
+	if (unlikely(!flow_offload_mtu_valid(flow, nf_ct_net(flow->ct)))) {
+		flow_offload_teardown(flow);
+		return NULL;
+	}
 
 	if (unlikely(nf_ct_is_dying(flow->ct)))
 		return NULL;
@@ -781,7 +789,7 @@
 }
 
 static void nf_flow_table_do_cleanup(struct nf_flowtable *flow_table,
-				     struct flow_offload *flow, void *data)
+                                     struct flow_offload *flow, void *data)
 {
 	struct net_device *dev = data;
 	int dir;
@@ -800,7 +808,8 @@
 
 		if (nf_flow_table_uses_dev(dev, tuple->iifidx) ||
 		    (flow->type == NF_FLOW_OFFLOAD_ROUTE &&
-		     ((tuple->xmit_type == FLOW_OFFLOAD_XMIT_DIRECT &&
+		     (nf_flow_table_uses_dev(dev, tuple->mtu_ifindex) ||
+		      (tuple->xmit_type == FLOW_OFFLOAD_XMIT_DIRECT &&
 		       (nf_flow_table_uses_dev(dev, tuple->out.ifidx) ||
 			nf_flow_table_uses_dev(dev, tuple->out.hw_ifidx))) ||
 		      (tuple->xmit_type != FLOW_OFFLOAD_XMIT_DIRECT &&
@@ -816,6 +825,8 @@
 			      struct net_device *dev)
 {
 	nf_flow_table_iterate(flowtable, nf_flow_table_do_cleanup, dev);
+	/* An ADD pending at teardown must finish before GC queues DESTROY. */
+	nf_flow_table_offload_flush(flowtable);
 	flush_delayed_work(&flowtable->gc_work);
 	nf_flow_table_offload_flush(flowtable);
 }
@@ -897,8 +908,17 @@
 {
 	struct net_device *dev = netdev_notifier_info_to_dev(ptr);
 
-	if (event != NETDEV_DOWN && event != NETDEV_CHANGEMTU)
+	switch (event) {
+	case NETDEV_PRECHANGEMTU:
+	case NETDEV_CHANGEMTU:
+	case NETDEV_CHANGEUPPER:
+	case NETDEV_CHANGEADDR:
+	case NETDEV_DOWN:
+	case NETDEV_UNREGISTER:
+		break;
+	default:
 		return NOTIFY_DONE;
+	}
 
 	nf_flow_table_cleanup(dev);
 
--- a/net/netfilter/nf_flow_table_ip.c
+++ b/net/netfilter/nf_flow_table_ip.c
@@ -389,7 +389,7 @@
 	dir = tuplehash->tuple.dir;
 	flow = container_of(tuplehash, struct flow_offload, tuplehash[dir]);
 
-	mtu = flow->tuplehash[dir].tuple.mtu + ctx->offset;
+	mtu = READ_ONCE(flow->tuplehash[dir].tuple.mtu) + ctx->offset;
 	if (unlikely(nf_flow_exceeds_mtu(skb, mtu)))
 		return 0;
 
@@ -684,7 +684,7 @@
 	dir = tuplehash->tuple.dir;
 	flow = container_of(tuplehash, struct flow_offload, tuplehash[dir]);
 
-	mtu = flow->tuplehash[dir].tuple.mtu + ctx->offset;
+	mtu = READ_ONCE(flow->tuplehash[dir].tuple.mtu) + ctx->offset;
 	if (unlikely(nf_flow_exceeds_mtu(skb, mtu)))
 		return 0;
 
--- a/net/netfilter/nf_flow_table_offload.c
+++ b/net/netfilter/nf_flow_table_offload.c
@@ -4,6 +4,7 @@
 #include <linux/netfilter.h>
 #include <linux/rhashtable.h>
 #include <linux/netdevice.h>
+#include <linux/rtnetlink.h>
 #include <linux/tc_act/tc_csum.h>
 #include <net/flow_offload.h>
 #include <net/netfilter/nf_flow_table.h>
@@ -984,10 +985,24 @@
 	return 0;
 }
 
+static void flow_offload_work_del(struct flow_offload_work *offload);
+
 static void flow_offload_work_add(struct flow_offload_work *offload)
 {
 	struct nf_flow_rule *flow_rule[FLOW_OFFLOAD_DIR_MAX];
 	int err;
+
+	/* Do not install while RTNL owns a device reconfiguration. */
+	if (rtnl_is_locked() || test_bit(NF_FLOW_TEARDOWN, &offload->flow->flags))
+		return;
+	rcu_read_lock();
+	err = flow_offload_mtu_valid(offload->flow, nf_ct_net(offload->flow->ct)) ?
+		0 : -ESTALE;
+	rcu_read_unlock();
+	if (err) {
+		flow_offload_teardown(offload->flow);
+		return;
+	}
 
 	err = nf_flow_offload_alloc(offload, flow_rule);
 	if (err < 0)
@@ -997,6 +1012,13 @@
 	if (err < 0)
 		goto out;
 
+	/* A notifier can retire a flow while a sleeping driver creates it.
+	 * Drain that installation before the notifier returns to its caller.
+	 */
+	if (test_bit(NF_FLOW_TEARDOWN, &offload->flow->flags)) {
+		flow_offload_work_del(offload);
+		goto out;
+	}
 	set_bit(IPS_HW_OFFLOAD_BIT, &offload->flow->ct->status);
 
 out:
