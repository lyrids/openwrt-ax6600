From: lyrids <ly7110@gmail.com>
Subject: [PATCH] wifi: ath11k: snapshot the RX debug peer address under base_lock

Peer unmap frees ath11k_peer immediately under base_lock. Do not pass its
address to the debug formatter after dropping that lock.

Signed-off-by: lyrids <ly7110@gmail.com>

---

diff --git a/drivers/net/wireless/ath/ath11k/dp_rx.c b/drivers/net/wireless/ath/ath11k/dp_rx.c
--- a/drivers/net/wireless/ath/ath11k/dp_rx.c
+++ b/drivers/net/wireless/ath/ath11k/dp_rx.c
@@ -2461,6 +2461,8 @@
 	struct ieee80211_radiotap_he *he = NULL;
 	struct ieee80211_sta *pubsta = NULL;
 	struct ath11k_peer *peer;
+	u8 peer_addr[ETH_ALEN];
+	bool have_peer = false;
 	struct ath11k_skb_rxcb *rxcb = ATH11K_SKB_RXCB(msdu);
 	u8 decap = DP_RX_DECAP_TYPE_RAW;
 	bool is_mcbc = rxcb->is_mcbc;
@@ -2479,15 +2481,18 @@
 
 	spin_lock_bh(&ar->ab->base_lock);
 	peer = ath11k_dp_rx_h_find_peer(ar->ab, msdu);
-	if (peer && peer->sta)
+	if (peer) {
+		ether_addr_copy(peer_addr, peer->addr);
+		have_peer = true;
 		pubsta = peer->sta;
+	}
 	spin_unlock_bh(&ar->ab->base_lock);
 
 	ath11k_dbg(ar->ab, ATH11K_DBG_DATA,
 		   "rx skb %p len %u peer %pM %d %s sn %u %s%s%s%s%s%s%s %srate_idx %u vht_nss %u freq %u band %u flag 0x%x fcs-err %i mic-err %i amsdu-more %i\n",
 		   msdu,
 		   msdu->len,
-		   peer ? peer->addr : NULL,
+		   have_peer ? peer_addr : NULL,
 		   rxcb->tid,
 		   is_mcbc ? "mcast" : "ucast",
 		   rxcb->seq_no,
